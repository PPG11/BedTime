{
  "name": "bedtime",
  "version": "2.0.0",
  "private": true,
  "description": "早睡助手：微信原生小程序 + TypeScript + CloudBase",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "cloudfunctions/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:weapp": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "dev:weapp": "node scripts/build.mjs --watch",
    "test": "node scripts/test.mjs",
    "cloud:preview": "node cloudfunctions/deploy.js --dry-run",
    "cloud:prepare": "node cloudfunctions/deploy.js --prepare-only --skip-focus --keep-lock --require-target",
    "upload:cloudfunctions": "node cloudfunctions/deploy.js --skip-focus --keep-lock --require-target",
    "verify": "yarn typecheck && yarn test && yarn build:weapp"
  },
  "devDependencies": {
    "miniprogram-api-typings": "3.12.3",
    "typescript": "5.9.3"
  }
}
