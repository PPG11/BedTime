<view class="friends">
  <view class="friends__card friends__card--intro" bindtap="copyUid">
    <text class="friends__title">我的 UID</text>
    <text class="friends__uid">{{uid || '正在加载 UID...'}}</text>
    <text class="friends__hint">点击即可复制 UID，好友就能向你发送邀请，共同互助早睡。</text>
  </view>
  <view wx:if="{{error}}" class="friends__error">
    <text>{{error}}</text>
    <button size="mini" bindtap="refreshFriends" disabled="{{syncing}}">重试</button>
  </view>
  <view class="friends__card">
    <text class="friends__title">添加好友</text>
    <view class="friends__form">
      <view class="friends__form-field">
        <text class="friends__label">好友 UID</text>
        <input class="friends__input" value="{{uidInput}}" placeholder="输入好友的 UID" maxlength="12" bindinput="onUidInput" disabled="{{syncing}}" />
      </view>
      <view class="friends__form-field">
        <text class="friends__label">备注（可选）</text>
        <input class="friends__input" value="{{aliasInput}}" placeholder="帮好友起个称呼" maxlength="16" bindinput="onAliasInput" disabled="{{syncing}}" />
      </view>
      <button class="friends__submit" type="primary" bindtap="addFriend" disabled="{{syncing || !uid}}">发送申请</button>
    </view>
  </view>
  <view class="friends__card">
    <text class="friends__title">好友申请</text>
    <view wx:if="{{incoming.length}}" class="friends__requests">
      <view wx:for="{{incoming}}" wx:key="requestId" class="friends__request-item">
        <view class="friends__request-info">
          <text class="friends__item-name">{{item.nickname}}</text>
          <text class="friends__item-uid">UID：{{item.uid}}</text>
          <text class="friends__request-meta">最近更新：{{item.updatedAtLabel}}</text>
        </view>
        <view class="friends__request-actions">
          <button size="mini" type="primary" data-id="{{item.requestId}}" data-accept="yes" bindtap="handleRequest" disabled="{{syncing}}">同意</button>
          <button size="mini" class="friends__remove" data-id="{{item.requestId}}" data-accept="no" bindtap="handleRequest" disabled="{{syncing}}">拒绝</button>
        </view>
      </view>
    </view>
    <text wx:else class="friends__empty">{{loaded ? '暂无新的好友申请。' : '正在加载好友申请...'}}</text>
    <view wx:if="{{outgoing.length}}" class="friends__requests">
      <text class="friends__hint">发出的申请</text>
      <view wx:for="{{outgoing}}" wx:key="requestId" class="friends__request-item">
        <view class="friends__request-info">
          <text class="friends__item-name">{{item.nickname}}</text>
          <text class="friends__item-uid">UID：{{item.uid}}</text>
        </view>
        <text class="friends__request-meta friends__request-status">{{item.statusLabel}}</text>
      </view>
    </view>
  </view>
  <view class="friends__card">
    <text class="friends__title">好友早睡情况</text>
    <view wx:if="{{friends.length}}" class="friends__list">
      <view wx:for="{{friends}}" wx:key="uid" class="friends__item">
        <view class="friends__item-header">
          <view class="friends__item-info">
            <text class="friends__item-name">{{item.displayName}}</text>
            <text wx:if="{{item.remark && item.remark !== item.nickname}}" class="friends__item-remark">原昵称：{{item.nickname}}</text>
            <text class="friends__item-uid">UID：{{item.uid}}</text>
          </view>
          <view class="friends__item-actions">
            <button size="mini" bindtap="refreshFriends" disabled="{{syncing}}">刷新</button>
            <button size="mini" class="friends__remove" data-uid="{{item.uid}}" bindtap="removeFriend" disabled="{{syncing}}">取消</button>
          </view>
        </view>
        <view class="friends__item-status">
          <text class="friends__status friends__status--{{item.todayStatus}}">{{item.todayStatusLabel}}</text>
        </view>
        <view class="friends__item-stats">
          <view class="friends__stat">
            <text class="friends__stat-value">{{item.streak}}</text>
            <text class="friends__stat-label">当前连胜</text>
          </view>
          <view class="friends__stat">
            <text class="friends__stat-value">{{item.sleeptime}}</text>
            <text class="friends__stat-label">目标就寝</text>
          </view>
        </view>
        <view class="friends__item-sync">
          <text>最近同步</text>
          <text>{{item.updatedAtLabel}}</text>
        </view>
      </view>
    </view>
    <text wx:else class="friends__empty">{{loaded ? '暂未添加好友，发送邀请后等待对方同意即可开始互相监督。' : '正在加载好友...'}}</text>
    <button wx:if="{{nextCursor}}" size="mini" bindtap="loadMore" loading="{{syncing}}" disabled="{{syncing}}">加载更多好友</button>
  </view>
</view>
