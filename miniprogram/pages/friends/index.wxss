.friends {
  min-height: 100vh;
  padding: 44rpx 28rpx 72rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f3f2ff 0%, #eef5ff 60%, #ffffff 100%);
  color: #2e2a59;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  font-size: 26rpx;
  line-height: 1.5;
  overscroll-behavior-y: contain;
}
.friends__card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.97) 0%, rgba(236, 240, 255, 0.94) 100%);
  border-radius: 30rpx;
  padding: 32rpx;
  box-shadow: 0 14rpx 34rpx rgba(110, 104, 214, 0.14);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.friends__card--intro {
  background: linear-gradient(135deg, #6f63ff 0%, #8f7aff 100%);
  color: #ffffff;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  box-shadow: 0 18rpx 44rpx rgba(82, 76, 170, 0.26);
}
.friends__card--intro:active {
  transform: scale(0.98);
  box-shadow: 0 12rpx 30rpx rgba(82, 76, 170, 0.22);
}
.friends__card--intro .friends__title {
  color: rgba(255, 255, 255, 0.92);
}
.friends__card--intro .friends__hint {
  color: rgba(255, 255, 255, 0.86);
}
.friends__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2e2a59;
}
.friends__uid {
  margin-top: 18rpx;
  padding: 18rpx 26rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #2e2a59;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-align: center;
  box-shadow: 0 16rpx 36rpx rgba(60, 56, 130, 0.18);
  border: 1rpx solid rgba(111, 99, 255, 0.18);
  font-family: "SFMono-Regular", "Menlo", "Courier New", monospace;
}
.friends__hint {
  font-size: 24rpx;
  color: #7a78a8;
  line-height: 1.6;
}
.friends__form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.friends__form-field {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-width: 0;
}
.friends__label {
  flex: 0 0 180rpx;
  font-size: 24rpx;
  color: #7a78a8;
}
.friends__input {
  flex: 1 1 0%;
  min-width: 0;
  width: 0;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(238, 240, 255, 0.86);
  padding: 0 22rpx;
  box-sizing: border-box;
  color: #2e2a59;
  font-size: 26rpx;
  line-height: 1.5;
}
button.friends__submit:not([size='mini']) {
  width: 100%;
  margin: 0;
  padding: 0 24rpx;
  height: 88rpx;
  line-height: 1;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #6f63ff 0%, #8f7aff 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  font-family: "HarmonyOS Sans SC", "PingFang SC", "Helvetica Neue", sans-serif;
  display: flex;
  align-items: center;
  justify-content: center;
}
.friends__submit::after {
  display: none;
}
.friends__list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.friends__requests {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.friends__item {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  box-shadow: 0 10rpx 26rpx rgba(110, 104, 214, 0.1);
}
.friends__request-item {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  justify-content: space-between;
  box-shadow: 0 10rpx 26rpx rgba(110, 104, 214, 0.1);
}
.friends__request-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
}
.friends__request-meta {
  font-size: 22rpx;
  color: #8684ba;
}
.friends__request-actions {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.friends__request-actions button[size='mini'],
.friends__item-actions button[size='mini'] {
  width: 108rpx;
  min-width: 108rpx;
  height: 56rpx;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: 24rpx;
  font-family: "HarmonyOS Sans SC", "PingFang SC", "Helvetica Neue", sans-serif;
  font-weight: 500;
}
.friends__item-header {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}
.friends__item-info {
  flex: 1 1 0%;
  min-width: 0;
  overflow-wrap: anywhere;
}
.friends__item-actions {
  flex: 0 0 auto;
  display: flex;
  gap: 12rpx;
  align-self: flex-start;
}
.friends__item-actions button::after {
  display: none;
}
.friends__remove {
  background: #fbe4ea;
  color: #d3667a;
}
.friends__item-name {
  display: block;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2e2a59;
}
.friends__item-remark {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8684ba;
}
.friends__item-uid {
  margin-top: 10rpx;
  display: block;
  font-size: 22rpx;
  color: #7a78a8;
}
.friends__item-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}
.friends__stat {
  background: rgba(248, 248, 255, 0.95);
  border-radius: 18rpx;
  padding: 18rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  text-align: center;
  box-shadow: inset 0 0 0 1rpx rgba(190, 188, 240, 0.5);
}
.friends__stat-value {
  display: block;
  min-height: 44rpx;
  line-height: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #6f63ff;
}
.friends__stat-label {
  display: block;
  font-size: 22rpx;
  color: #7a78a8;
}
.friends__item-status {
  display: flex;
  justify-content: flex-start;
}
.friends__status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: rgba(111, 99, 255, 0.16);
  color: #6f63ff;
}
.friends__status--hit {
  background: rgba(95, 217, 188, 0.22);
  color: #1fa97a;
}
.friends__status--late {
  background: rgba(255, 212, 142, 0.26);
  color: #d48a1f;
}
.friends__status--miss {
  background: rgba(255, 193, 166, 0.24);
  color: #d8733f;
}
.friends__status--pending {
  background: rgba(111, 99, 255, 0.12);
  color: #7a78a8;
}
.friends__empty {
  font-size: 24rpx;
  color: #7a78a8;
}
.friends__item-sync {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8684ba;
}
.friends__request-status {
  flex: 0 0 auto;
  white-space: nowrap;
}
.friends__error {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
  color: #b14f60;
}
button.friends__submit[disabled] { opacity: 0.55; }
.friends__request-info { min-width: 0; overflow-wrap: anywhere; }

/* Screen breakpoints use px; rpx scales with the same viewport being tested. */
@media screen and (max-width: 360px) {
  .friends__item-header {
    flex-direction: column;
  }
  .friends__item-info {
    flex: none;
    width: 100%;
  }
  .friends__item-actions {
    width: 100%;
  }
  .friends__item-actions button[size='mini'] {
    flex: 1 1 0%;
    width: 0;
    min-width: 0;
  }
}
