<view class="index">
  <view class="hero">
    <view class="hero__atmosphere">
      <view class="hero__orb hero__orb--one" /><view class="hero__orb hero__orb--two" />
      <view class="hero__spark hero__spark--one" /><view class="hero__spark hero__spark--two" />
    </view>
    <view class="hero__info">
      <text class="hero__badge">🌙 晚安小宇宙</text>
      <text class="hero__greeting">你好，{{displayName}}</text>
      <text class="hero__subtitle">{{weekdayLabel}}</text>
      <text class="hero__title">{{dateLabel}}</text>
    </view>
    <view class="hero__countdown">
      <view class="hero__countdown-ring"><text class="hero__countdown-icon">⏰</text><view class="hero__countdown-glow" /></view>
      <view class="hero__countdown-meta">
        <text class="hero__countdown-label">{{countdownLabel}}</text>
        <text class="hero__countdown-time">{{countdownText}}</text>
        <text class="hero__countdown-target">推荐 <text class="hero__countdown-target-value">{{recommendedSleepTime}}</text></text>
      </view>
    </view>
  </view>
  <view wx:if="{{error}}" class="error-card">
    <text class="error-card__message">{{error}}</text>
    <button size="mini" bindtap="onRetry" loading="{{loading}}" disabled="{{loading}}">重新加载</button>
  </view>
  <view class="checkin-card {{showHitEffects ? 'checkin-card--hit' : showLateEffects ? 'checkin-card--late' : ''}}">
    <view class="checkin-card__effects" aria-hidden="true">
      <view wx:if="{{showHitEffects}}" class="checkin-card__hit-effects">
        <view class="checkin-card__hit-glow" /><view class="checkin-card__hit-glow checkin-card__hit-glow--secondary" />
        <view class="checkin-card__hit-ring" />
        <view class="checkin-card__hit-spark checkin-card__hit-spark--one" /><view class="checkin-card__hit-spark checkin-card__hit-spark--two" /><view class="checkin-card__hit-spark checkin-card__hit-spark--three" />
      </view>
      <view wx:elif="{{showLateEffects}}" class="checkin-card__late-effects">
        <view class="checkin-card__late-trail" /><view class="checkin-card__late-trail checkin-card__late-trail--two" />
        <view class="checkin-card__late-orb" /><view class="checkin-card__late-shock" />
        <view class="checkin-card__late-clock"><view class="checkin-card__late-hand" /></view>
      </view>
    </view>
    <view class="checkin-card__pill"><text class="checkin-card__pill-icon">{{pillIcon}}</text><text class="checkin-card__pill-text">{{pillText}}</text></view>
    <text class="checkin-card__title">今日早睡打卡</text>
    <text class="checkin-card__note">💤 柔柔提醒：睡前给自己温柔拥抱</text>
    <text class="checkin-card__status checkin-card__status--{{statusTone}}">{{statusText}}</text>
    <text class="checkin-card__timestamp checkin-card__timestamp--{{statusTone}}">{{timestampText}}</text>
    <view class="checkin-card__progress"><view class="checkin-card__progress-bar" style="width: {{progressWidth}};" /></view>
    <button class="checkin-card__button" type="primary" disabled="{{checkinDisabled || isSyncing}}" loading="{{isSyncing}}" bindtap="onCheckin">{{checkinButtonText}}</button>
  </view>
  <view wx:if="{{rewardMessage}}" class="goodnight-reward-card" bindtap="onOpenReward" role="button" aria-label="查看今日晚安心语">
    <text class="goodnight-reward-card__badge">今日收到的祝福</text>
    <text class="goodnight-reward-card__content">{{rewardMessage.content}}</text>
    <text class="goodnight-reward-card__footer">来自早睡伙伴的温暖陪伴 ✨</text>
    <text class="goodnight-reward-card__action">查看祝福与反馈</text>
  </view>
  <view class="goodnight-card">
    <text class="goodnight-card__title">晚安心语</text>
    <text class="goodnight-card__description">留下一句温暖的话语，陪伴正在努力早睡的伙伴们。</text>
    <view wx:if="{{hasSubmitted && submittedMessage}}" class="goodnight-card__submitted">
      <text class="goodnight-card__submitted-label">今日已分享</text>
      <text class="goodnight-card__submitted-content">{{submittedMessage.content}}</text>
    </view>
    <block wx:else>
      <textarea wx:if="{{!modalVisible}}" class="goodnight-card__textarea" value="{{goodnightInput}}" maxlength="{{maxLength}}" placeholder="写下一句鼓励、祝福或睡前感悟~" bindinput="onGoodnightInput" disabled="{{hasSubmitted || isSubmitting}}" auto-height />
      <text class="goodnight-card__counter">还可以输入 {{remainingCharacters}} 字</text>
    </block>
    <text wx:if="{{goodnightError}}" class="goodnight-card__error">{{goodnightError}}</text>
    <button class="goodnight-card__button" type="primary" bindtap="onSubmitGoodnight" disabled="{{!uid || hasSubmitted || isSubmitting}}" loading="{{isSubmitting}}">{{hasSubmitted ? '今日已分享' : '送出晚安心语'}}</button>
  </view>
  <view class="stats-grid">
    <view wx:for="{{stats}}" wx:key="label" class="stats-card stats-card--{{item.tone}}">
      <view class="stats-card__header"><text class="stats-card__icon">{{item.icon}}</text><text class="stats-card__label">{{item.label}}</text></view>
      <text class="stats-card__value">{{item.value}}</text><view class="stats-card__spark" />
    </view>
  </view>
  <view class="recent">
    <text class="recent__title">🌙 最近 7 天打卡</text><text class="recent__hint">左右滑动，收集你的早睡星星</text>
    <scroll-view class="recent__scroll" scroll-x>
      <view class="recent__list">
        <view wx:for="{{recentDays}}" wx:key="key" class="recent__item {{item.checked ? 'recent__item--checked' : ''}}">
          <text class="recent__date">{{item.label}}</text><text class="recent__weekday">{{item.weekday}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
  <view class="tips">
    <text class="tips__title">💗 早睡小贴士</text><text class="tips__subtitle">慢慢呼吸，轻轻进入梦乡</text>
    <view class="tips__list"><text wx:for="{{sleepTips}}" wx:key="*this" class="tips__item">{{item}}</text></view>
  </view>
  <view wx:if="{{modalVisible && modalMessage}}" class="goodnight-modal" catchtouchmove="preventTouchMove">
    <view class="goodnight-modal__backdrop" bindtap="onCloseReward" />
    <view class="goodnight-modal__panel">
      <text class="goodnight-modal__title">今日晚安心语</text>
      <text class="goodnight-modal__content">{{modalMessage.content}}</text>
      <text class="goodnight-modal__hint">感谢分享者的温暖，如果喜欢可以点个赞哦～</text>
      <view class="goodnight-modal__actions">
        <button class="goodnight-modal__button goodnight-modal__button--dislike" data-vote="dislike" bindtap="onVote" disabled="{{hasVoted || isVoting}}">👎 踩 {{modalMessage.dislikes > 0 ? '(' + modalMessage.dislikes + ')' : ''}}</button>
        <button class="goodnight-modal__button goodnight-modal__button--like" data-vote="like" bindtap="onVote" disabled="{{hasVoted || isVoting}}">👍 赞 {{modalMessage.likes > 0 ? '(' + modalMessage.likes + ')' : ''}}</button>
      </view>
      <button class="goodnight-modal__close" bindtap="onCloseReward">收下祝福</button>
    </view>
  </view>
</view>
