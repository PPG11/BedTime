}

.checkin-card--late {
  box-shadow: 0 24rpx 58rpx rgba(255, 126, 146, 0.28);
}

.checkin-card__effects {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.checkin-card__hit-effects,
.checkin-card__late-effects {
  position: absolute;
  inset: 0;
}

.checkin-card__hit-glow {
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  top: -80rpx;
  right: -40rpx;
  background: radial-gradient(circle, rgba(86, 255, 207, 0.7), rgba(86, 255, 207, 0));
  filter: blur(4rpx);
  animation: hitPulse 4.4s ease-in-out infinite;
}

.checkin-card__hit-glow--secondary {
  width: 280rpx;
  height: 280rpx;
  top: auto;
  bottom: -140rpx;
  right: auto;
  left: -120rpx;
  background: radial-gradient(circle, rgba(118, 157, 255, 0.75), rgba(118, 157, 255, 0));
  animation-duration: 5.2s;
}

.checkin-card__hit-ring {
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(81, 224, 184, 0.5);
  top: 50%;
  left: 50%;
  margin: -130rpx 0 0 -130rpx;
  animation: hitOrbit 10s linear infinite;
  opacity: 0.6;
}

.checkin-card__hit-spark {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7ef7d5, #64d8ff);
  box-shadow: 0 0 16rpx rgba(126, 247, 213, 0.9);
  animation: hitSparkle 2.4s ease-in-out infinite;
}

.checkin-card__hit-spark--one {
  top: 36%;
  right: 18%;
}

.checkin-card__hit-spark--two {
  top: 18%;
  left: 26%;
  animation-delay: 0.4s;
}

.checkin-card__hit-spark--three {
  bottom: 10%;
  right: 30%;
  animation-delay: 0.8s;
}

.checkin-card__late-trail {
  position: absolute;
  width: 160%;
  height: 140rpx;
  top: 8%;
  left: -30%;
  border-radius: 50%;
  background: linear-gradient(90deg, rgba(255, 141, 170, 0), rgba(255, 141, 170, 0.6), rgba(255, 208, 166, 0));
  filter: blur(10rpx);
  transform: rotate(-8deg);
  animation: lateTrailSweep 3.2s ease-in-out infinite;
  mix-blend-mode: screen;
}

.checkin-card__late-trail--two {
  top: auto;
  bottom: 6%;
  transform: rotate(6deg);
  animation-duration: 2.4s;
  animation-delay: 0.3s;
}

.checkin-card__late-orb {
  position: absolute;
