  color: #7a78a8;
  white-space: nowrap;
  letter-spacing: 1rpx;
}

.hero__countdown-target-value {
  margin-left: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #4a438b;
}

.checkin-card {
  position: relative;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(238, 243, 255, 0.95) 100%);
  border-radius: 38rpx;
  padding: 36rpx 34rpx;
