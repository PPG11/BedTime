@keyframes auroraShift {
  0% {
    background-position: 0% 0%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 100%;
  }
}

@keyframes floatUp {
  0% {
    transform: translateY(0rpx);
  }
  50% {
    transform: translateY(-10rpx);
  }
  100% {
    transform: translateY(0rpx);
  }
}

@keyframes pulseGlow {
  0% {
    opacity: 0.35;
    transform: scale(0.9);
  }
  50% {
    opacity: 0.8;
    transform: scale(1.05);
  }
  100% {
    opacity: 0.35;
    transform: scale(0.92);
  }
}

@keyframes fadeUp {
  0% {
    opacity: 0;
    transform: translateY(30rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes shimmer {
  0% {
    background-position: 0% 50%;
  }
  100% {
    background-position: 200% 50%;
  }
}

@keyframes hitPulse {
  0% {
    transform: scale(0.8);
    opacity: 0.35;
  }
  50% {
    transform: scale(1.05);
    opacity: 0.85;
  }
  100% {
    transform: scale(0.8);
    opacity: 0.35;
  }
}

@keyframes hitSparkle {
  0% {
    transform: translate3d(0, 0, 0) scale(0.7);
    opacity: 0;
  }
  30% {
    opacity: 0.9;
  }
  70% {
    transform: translate3d(26rpx, -24rpx, 0) scale(1);
    opacity: 1;
  }
  100% {
    transform: translate3d(38rpx, -46rpx, 0) scale(0.7);
    opacity: 0;
  }
}

@keyframes hitOrbit {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

@keyframes lateTrailSweep {
  0% {
    transform: translateX(-30%) rotate(-8deg);
    opacity: 0.2;
  }
  50% {
    opacity: 0.85;
  }
  100% {
    transform: translateX(30%) rotate(-8deg);
    opacity: 0.2;
  }
}

@keyframes lateShock {
  0% {
    transform: scale(0.95) rotate(-2deg);
    opacity: 0.4;
  }
  50% {
    transform: scale(1.05) rotate(2deg);
    opacity: 0.85;
  }
  100% {
    transform: scale(0.95) rotate(-2deg);
    opacity: 0.4;
  }
}

@keyframes lateClockHand {
  0% {
    transform: rotate(-40deg);
  }
  100% {
    transform: rotate(320deg);
  }
}

.index {
  min-height: 100vh;
  padding: 52rpx 32rpx 96rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #f7f5ff, #ecf0ff, #fef8ff);
  background-size: 200% 200%;
  animation: auroraShift 22s ease-in-out infinite;
  color: #2e2a59;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  font-size: 26rpx;
  line-height: 1.5;
  position: relative;
  overflow: hidden;
  overscroll-behavior-y: contain;
  font-family: 'HarmonyOS Sans SC', 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.index::before,
.index::after {
  content: '';
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  filter: blur(80rpx);
  z-index: -1;
  opacity: 0.5;
}

.index::before {
  background: #d8d2ff;
  top: -160rpx;
  right: -180rpx;
  animation: floatUp 24s ease-in-out infinite;
}

.index::after {
  background: #d3e4ff;
  bottom: -200rpx;
  left: -140rpx;
  animation: floatUp 18s ease-in-out infinite reverse;
}

.hero,
.checkin-card,
.goodnight-reward-card,
.goodnight-card,
.stats-grid,
.recent,
.tips {
  opacity: 0;
  animation: fadeUp 0.8s ease forwards;
}

.hero {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.25fr);
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(236, 241, 255, 0.9));
  border-radius: 36rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 20rpx 48rpx rgba(108, 102, 214, 0.2);
  gap: 20rpx;
  overflow: hidden;
  animation-delay: 0.05s;
}

.hero::after {
  content: '';
  position: absolute;
  width: 180rpx;
  height: 180rpx;
  background: rgba(144, 136, 255, 0.22);
  border-radius: 50%;
  right: -40rpx;
  top: -60rpx;
  z-index: 0;
  filter: blur(10rpx);
  animation: floatUp 12s ease-in-out infinite;
}

.hero__atmosphere {
  position: absolute;
  inset: -30rpx;
  z-index: 0;
  pointer-events: none;
}

.hero__orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(2rpx);
  opacity: 0.5;
  animation: floatUp 10s ease-in-out infinite;
}

.hero__orb--one {
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.8), rgba(119, 109, 255, 0.2));
  top: 0;
  left: -40rpx;
}

.hero__orb--two {
  width: 160rpx;
  height: 160rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.7), rgba(160, 210, 255, 0.2));
  right: -20rpx;
  bottom: 10rpx;
  animation-duration: 14s;
}

.hero__spark {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  box-shadow: 0 0 12rpx rgba(255, 255, 255, 0.7);
  animation: pulseGlow 4s ease-in-out infinite;
}

.hero__spark--one {
  top: 42rpx;
  right: 26%;
  animation-delay: 0.6s;
}

.hero__spark--two {
  bottom: 38rpx;
  left: 30%;
  animation-delay: 1.4s;
}

.hero__info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  white-space: nowrap;
  z-index: 1;
  position: relative;
}

.hero__badge {
  align-self: flex-start;
  padding: 8rpx 18rpx;
  background: linear-gradient(135deg, #e6e2ff 0%, #f1f5ff 100%);
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #6f63ff;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.hero__greeting {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 28rpx;
  font-weight: 600;
  color: #4a438b;
  white-space: nowrap;
}

.hero__subtitle {
  font-size: 22rpx;
  color: #7a78a8;
  white-space: nowrap;
}

.hero__title {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #2e2a59;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.hero__countdown {
  min-width: 0;
  width: 100%;
  background: rgba(248, 247, 255, 0.92);
  border-radius: 24rpx;
  padding: 14rpx 16rpx;
  display: grid;
  grid-template-columns: 56rpx minmax(0, 1fr);
  align-items: center;
  justify-content: flex-end;
  color: #5754af;
  gap: 10rpx;
  border: 1rpx solid rgba(208, 206, 255, 0.7);
  box-shadow: 0 12rpx 28rpx rgba(110, 104, 210, 0.16);
  white-space: nowrap;
  position: relative;
  z-index: 1;
}

.hero__countdown-icon {
  font-size: 30rpx;
  line-height: 1;
  color: #6f63ff;
  position: relative;
  z-index: 2;
}

.hero__countdown-ring {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(233, 236, 255, 0.78));
  overflow: hidden;
}

.hero__countdown-glow {
  position: absolute;
  width: 160%;
  height: 160%;
  background: radial-gradient(circle, rgba(146, 138, 255, 0.5), transparent 70%);
  animation: pulseGlow 4s ease-in-out infinite;
}

.hero__countdown-meta {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  text-align: right;
  gap: 6rpx;
}

.hero__countdown-label {
  font-size: 22rpx;
  opacity: 0.82;
  color: #7a78a8;
  white-space: nowrap;
  display: block;
}

.hero__countdown-time {
  display: block;
  margin-top: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #5d57c7;
  white-space: nowrap;
}

.hero__countdown-target {
  margin-top: 0;
