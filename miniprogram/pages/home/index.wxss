  overflow: hidden;
}

.stats-card__header {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #6f63ff;
}

.stats-card__value {
  font-size: 36rpx;
  font-weight: 700;
  color: #6f63ff;
  white-space: nowrap;
}

.stats-card__label {
  font-size: 22rpx;
  color: #6b689c;
  white-space: nowrap;
}

.stats-card__icon {
  font-size: 24rpx;
  line-height: 1;
}

.stats-card__spark {
  position: absolute;
  inset: 12rpx 14rpx auto auto;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  filter: blur(0rpx);
  opacity: 0.4;
}

.stats-card--dawn {
  background: linear-gradient(135deg, rgba(248, 245, 255, 0.96), rgba(234, 231, 255, 0.9));
}

.stats-card--twinkle {
  background: linear-gradient(135deg, rgba(255, 247, 255, 0.95), rgba(252, 236, 255, 0.92));
}

.stats-card--glow {
  background: linear-gradient(135deg, rgba(241, 250, 255, 0.95), rgba(228, 242, 255, 0.9));
}

.stats-card--blush {
  background: linear-gradient(135deg, rgba(255, 246, 248, 0.95), rgba(255, 234, 241, 0.9));
}

.stats-card--twinkle .stats-card__value,
.stats-card--blush .stats-card__value {
  color: #f06095;
}

.stats-card--glow .stats-card__value {
  color: #3ca7d7;
}

.recent {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(236, 240, 255, 0.94) 100%);
  border-radius: 28rpx;
  padding: 26rpx;
  box-shadow: 0 16rpx 40rpx rgba(110, 104, 214, 0.14);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  overflow: hidden;
  animation-delay: 0.3s;
}

.recent__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2e2a59;
  white-space: nowrap;
}

.recent__hint {
  font-size: 22rpx;
  color: #8684ba;
  white-space: nowrap;
}

.recent__scroll {
  width: 100%;
  min-width: 0;
}

.recent__list {
  display: flex;
  gap: 8rpx;
  justify-content: flex-start;
  padding: 8rpx 0 14rpx;
  scrollbar-width: none;
  scroll-snap-type: x proximity;
  white-space: nowrap;
}

.recent__list::-webkit-scrollbar {
  display: none;
}

.recent__item {
  flex: 0 0 auto;
  min-width: 82rpx;
  scroll-snap-align: start;
  border-radius: 16rpx;
  padding: 8rpx 10rpx;
  margin: 0;
  background: rgba(255, 255, 255, 0.82);
  color: #7a78a8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 3rpx;
  border: 1rpx solid transparent;
  transition: transform 0.2s ease, background 0.2s ease, border 0.2s ease, box-shadow 0.2s ease;
  white-space: nowrap;
}

.recent__item--checked {
  background: linear-gradient(135deg, #6f63ff 0%, #8f7aff 100%);
  color: #ffffff;
  transform: translateY(-6rpx);
  border-color: rgba(255, 255, 255, 0.45);
  box-shadow: 0 12rpx 28rpx rgba(110, 104, 214, 0.28);
}

.recent__date {
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.recent__weekday {
  font-size: 18rpx;
  opacity: 0.85;
  white-space: nowrap;
}

.tips {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(239, 242, 255, 0.94) 100%);
  border-radius: 32rpx;
  padding: 34rpx;
  box-shadow: 0 16rpx 42rpx rgba(110, 104, 214, 0.14);
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  animation-delay: 0.35s;
}

.tips__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2e2a59;
  white-space: nowrap;
}

.tips__subtitle {
  font-size: 24rpx;
  color: #8684ba;
  white-space: nowrap;
}

.tips__list {
  display: grid;
  gap: 16rpx;
}

.tips__item {
  position: relative;
  padding: 20rpx 24rpx 20rpx 64rpx;
  border-radius: 24rpx;
  background: rgba(236, 232, 255, 0.92);
  color: #5f5cb1;
  font-size: 24rpx;
  line-height: 1.65;
  box-shadow: 0 10rpx 22rpx rgba(110, 104, 214, 0.14);
  border: 1rpx solid rgba(188, 186, 240, 0.5);
}

.tips__item::before {
  content: '💞';
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  line-height: 1;
}

.goodnight-modal {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.goodnight-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(43, 33, 78, 0.45);
}

.goodnight-modal__panel {
  position: relative;
  max-height: 85vh;
  overflow-y: auto;
  width: 82%;
  max-width: 640rpx;
  padding: 42rpx 38rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(236, 240, 255, 0.98) 100%);
  box-shadow: 0 28rpx 64rpx rgba(88, 84, 176, 0.24);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  z-index: 1;
}

.goodnight-modal__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2e2a59;
  text-align: center;
}

.goodnight-modal__content {
  font-size: 28rpx;
  color: #2e2a59;
  line-height: 1.7;
  text-align: left;
  white-space: pre-line;
}

.goodnight-modal__hint {
  font-size: 24rpx;
  color: #8684ba;
  text-align: center;
}

.goodnight-modal__actions {
  display: flex;
  gap: 18rpx;
}

button.goodnight-modal__button:not([size="mini"]) {
  flex: 1;
  min-width: 0;
  width: 0;
  margin: 0;
  padding: 0 12rpx;
  line-height: 1.4;
  height: 80rpx;
  border-radius: 24rpx;
  border: none;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

button.goodnight-modal__button--dislike:not([size="mini"]) {
  background: linear-gradient(135deg, #e2e5ff 0%, #f2defd 100%);
  color: #5a559d;
}

button.goodnight-modal__button--like:not([size="mini"]) {
  background: linear-gradient(135deg, #6f63ff 0%, #8f7aff 100%);
}

.goodnight-modal__button[disabled] {
  opacity: 0.6;
}

button.goodnight-modal__close:not([size="mini"]) {
  margin: 4rpx 0 0;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
  align-self: center;
  width: 60%;
  height: 72rpx;
  border-radius: 24rpx;
  border: none;
  background: linear-gradient(135deg, #e8e7ff 0%, #f2ecff 100%);
  color: #5f5cb1;
  font-size: 26rpx;
  font-weight: 600;
}

.error-card { position: relative; z-index: 1; padding: 24rpx; border-radius: 24rpx; background: #fff4ed; color: #8a4b30; }
.error-card__message { display: block; margin-bottom: 16rpx; }
.goodnight-card__error { display: block; color: #8a4b30; margin-top: 16rpx; font-size: 24rpx; }
.goodnight-reward-card { text-align: left; }
.goodnight-reward-card__action { display: block; margin-top: 12rpx; color: #6f63ff; font-size: 24rpx; }
