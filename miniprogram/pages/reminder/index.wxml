<view class="standard-page reminder-page">
  <text class="eyebrow">留一个轻轻的提醒</text>
  <text class="page-title">到时候，提醒我一次。</text>
  <text class="page-intro">自己选一个时间。订阅一次，只安排一次；下次需要时，再来订阅。</text>
  <text wx:if="{{loading}}" class="hint">正在读取提醒安排…</text>
  <block wx:else>
    <text wx:if="{{testing}}" class="notice">临时测试：今晚已关灯也可以提醒一次。默认约两分钟后，{{testEnds}} 自动恢复正常规则。</text>
    <view wx:if="{{scheduledAt}}" class="reminder-card">
      <text class="label">最近一次安排 · 北京时间</text>
      <text class="scheduled-at">{{scheduledAt}}</text>
      <text class="status" aria-role="status">{{statusText}}</text>
      <button wx:if="{{canCancel}}" class="text-button cancel-button" disabled="{{busy}}" bindtap="onCancel">取消这次提醒</button>
    </view>
    <view wx:if="{{enabled && canSchedule}}" class="reminder-card">
      <text class="label">提醒时间 · 北京时间</text>
      <picker mode="time" value="{{time}}" disabled="{{busy}}" bindchange="onTimeChange" aria-label="选择关灯提醒时间">
        <view class="time-picker"><text>{{time}}</text><text class="picker-action">选择时间 ›</text></view>
      </picker>
      <text wx:if="{{testing}}" class="hint">请选择测试结束前的时间；时间已过时，可点下方「重新读取安排」。</text>
      <text wx:else class="hint">可选 20:00—次日 05:59。已过的时间、已关灯的夜晚，会排到下一晚。</text>
      <text wx:if="{{target}}" class="target">这次安排：{{target}}</text>
      <button class="primary-button" disabled="{{busy || !target}}" bindtap="onSubscribe">{{busy ? '正在确认…' : '订阅这一次提醒'}}</button>
    </view>
    <text wx:if="{{!enabled && !notice}}" class="hint">关灯提醒暂未开放。你仍然可以照常关灯。</text>
    <text wx:if="{{notice}}" class="notice" aria-role="alert">{{notice}}</text>
    <button wx:if="{{canRetry}}" class="primary-button retry-button" disabled="{{busy}}" bindtap="onRetrySchedule">重试同一次安排</button>
    <button class="text-button reload-button" disabled="{{busy}}" bindtap="onReload">{{unknown ? '查看安排结果' : '重新读取安排'}}</button>
  </block>
  <text class="footnote">{{testing ? '测试通知会标明「测试提醒」，点击打开开发版。' : '发送前会检查这一晚是否已关灯。'}}微信通知可能延迟；超过约定时间 5 分钟便不再发起发送，已经发出的消息无法撤回。</text>
</view>
