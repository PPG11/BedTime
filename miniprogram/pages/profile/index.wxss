.profile {
  min-height: 100vh;
  padding: 44rpx 28rpx 72rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f3f2ff 0%, #eef5ff 60%, #ffffff 100%);
  color: #2e2a59;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  font-size: 26rpx;
  line-height: 1.5;
  overscroll-behavior-y: contain;
}
.profile__card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.97) 0%, rgba(236, 240, 255, 0.94) 100%);
  border-radius: 30rpx;
  padding: 32rpx;
  box-shadow: 0 14rpx 34rpx rgba(110, 104, 214, 0.14);
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.profile__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2e2a59;
}
.profile__uid {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #6f63ff;
}
.profile__uid-hint {
  font-size: 24rpx;
  color: #7a78a8;
  line-height: 1.6;
}
button.profile__copy:not([size='mini']) {
  align-self: flex-start;
  width: auto;
  min-width: 180rpx;
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 1;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #6f63ff 0%, #8f7aff 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-family: "HarmonyOS Sans SC", "PingFang SC", "Helvetica Neue", sans-serif;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}
.profile__copy::after {
  display: none;
}
button.profile__copy[disabled]:not([size='mini']) {
  background: #e0e3ff;
  color: #7774a5;
}
.profile__field {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-width: 0;
}
.profile__label {
  flex: 0 0 180rpx;
  font-size: 24rpx;
  color: #7a78a8;
  white-space: nowrap;
}
.profile__input,
.profile__time-picker {
  flex: 1 1 0%;
  min-width: 0;
  width: 0;
}
.profile__input,
.profile__picker {
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(238, 240, 255, 0.86);
  padding: 0 22rpx;
  box-sizing: border-box;
  color: #2e2a59;
  font-size: 26rpx;
  line-height: 1.5;
}
.profile__picker {
  width: 100%;
  display: flex;
  align-items: center;
}
.profile__tips {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(236, 240, 255, 0.94) 100%);
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 12rpx 32rpx rgba(110, 104, 214, 0.12);
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.profile__tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2e2a59;
}
.profile__tips-item {
  font-size: 24rpx;
  color: #5f5cb1;
  line-height: 1.6;
}
.profile__error { display: flex; flex-direction: column; align-items: flex-start; gap: 16rpx; color: #b14f60; }
