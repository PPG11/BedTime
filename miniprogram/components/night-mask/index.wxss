.immersive { position: fixed; inset: 0; z-index: 20; box-sizing: border-box; display: flex; flex-direction: column; padding-left: 28px; padding-right: 28px; padding-bottom: calc(32px + env(safe-area-inset-bottom)); color: #b8adb8; overflow-y: auto; }
.black { position: fixed; inset: 0; background: #000; z-index: -1; }
.demo-label { display: block; text-align: center; font-size: 12px; line-height: 1.6; color: #9a8f9c; }
.exit-notice { display: block; text-align: center; font-size: 13px; line-height: 1.8; padding: 8px 0; }
.phrase-region { flex: 1 0 auto; min-height: 180px; display: flex; align-items: center; justify-content: center; padding: 32px 0 64px; }
.phrase { display: block; max-width: 480px; text-align: left; font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 22px; line-height: 1.9; letter-spacing: 1px; white-space: pre-wrap; }
.exits, .early-exit { flex-shrink: 0; width: 100%; max-width: 400px; align-self: center; }
button.end-button:not([size='mini']), button.return-button:not([size='mini']) { width: 100%; margin: 0; padding: 10px 18px; min-height: 48px; box-sizing: border-box; line-height: 1.7; font-size: 16px; color: #b8adb8; background: transparent; font-weight: normal; }
button.end-button::after, button.return-button::after { border: 0; }
button.return-button:not([size='mini']) { font-size: 14px; color: #9a8f9c; }
@media (max-width: 350px) { .immersive { padding-left: 24px; padding-right: 24px; padding-bottom: calc(16px + env(safe-area-inset-bottom)); } .phrase-region { padding-bottom: 36px; } }
