<view class="hold-target hold-target--{{variant}} {{held ? 'is-held' : ''}} {{enabled ? '' : 'is-disabled'}}"
  aria-role="button" aria-label="{{label}}，也可以使用页面下方的轻点关灯"
  aria-disabled="{{!enabled}}" bindtouchstart="onTouchStart" catchtouchmove="onTouchMove"
  bindtouchend="onTouchEnd" bindtouchcancel="cancelGesture">
  <slot></slot>
  <text wx:if="{{variant === 'button'}}">{{label}}</text>
</view>
