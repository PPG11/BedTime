page {
  width: 100%;
  min-height: 100%;
  background: #140f1e;
  color: #e8e2d6;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
}

view, scroll-view, input, textarea, button, picker {
  box-sizing: border-box;
}

/* Native buttons have automatic margins and v2 size rules; pages own their width. */
button {
  margin: 0;
  font-family: inherit;
}

button::after { border: none; }

.standard-page { max-width: 560px; margin: 0 auto; padding: 32px 24px calc(32px + env(safe-area-inset-bottom)); }
.eyebrow { display: block; color: #b4a8b6; font-size: 12px; line-height: 1.8; letter-spacing: 2px; }
.page-title { display: block; font-size: 27px; line-height: 1.6; margin-top: 14px; letter-spacing: 1px; }
.page-intro { display: block; font-size: 14px; line-height: 1.9; margin-top: 18px; color: #b4a8b6; }
button.primary-button:not([size='mini']), button.text-button:not([size='mini']) { width: 100%; margin: 0; padding: 14px 18px; min-height: 48px; font-size: 16px; font-weight: normal; line-height: 1.7; box-sizing: border-box; }
button.primary-button:not([size='mini']) { border: 1px solid #8c704a; border-radius: 16px; background: #211c24; color: #f0cd96; }
button.text-button:not([size='mini']) { background: transparent; color: #b4a8b6; }
button.primary-button[disabled]:not([size='mini']), button.text-button[disabled]:not([size='mini']) { color: #9a8f9c; opacity: 0.65; }
@media (max-width: 350px) { .standard-page { padding-left: 20px; padding-right: 20px; } .page-title { font-size: 25px; } }
